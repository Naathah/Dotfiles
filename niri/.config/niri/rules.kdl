layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match app-id="zed"
    match app-id="org.telegram.desktop"
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match app-id="^(steam_app_.*)$"
    variable-refresh-rate true
    open-fullscreen true
}

window-rule {
    match app-id="localsend"
    match app-id="^signal$"
    default-column-width { proportion 0.3333333333333333; }
}

window-rule {
    match app-id="celluloid"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

window-rule {
    match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

window-rule {
    match app-id=r"^gnome-control-center$"
    match app-id=r"^pavucontrol$"
    match app-id=r"^nm-connection-editor$"
    default-column-width { proportion 0.5; }
    open-floating false
}

window-rule {
    match app-id=r"^org\.gnome\.Calculator$"
    match app-id=r"^gnome-calculator$"
    match app-id=r"^blueman-manager$"
    match app-id=r"^xdg-desktop-portal$"
    match app-id="^com.interversehq.qView$"
    match app-id=r"firefox$" title="^Picture-in-Picture$"
    match app-id=r"zen$" title="^Picture-in-Picture$"
    match app-id=r"librewolf$" title="^Picture-in-Picture$"
    match app-id="KeePassXC"
    match app-id="zoom"
    match app-id="^sushi$"
    open-floating true
}

window-rule {
    match app-id=r"^org\.wezfurlong\.wezterm$"
    match app-id="Alacritty"
    match app-id="com.mitchellh.ghostty"
    match app-id="foot"
    match app-id="^org.gnome.Calculator$"
    match app-id="Nautilus"
    match app-id="KeePassXC"
    match app-id="^signal$"
    match app-id="^org.gnome.TextEditor$"
    opacity 0.75
    background-effect {
    blur true
    }
    draw-border-with-background false
}

debug {
    honor-xdg-activation-with-invalid-serial
}
