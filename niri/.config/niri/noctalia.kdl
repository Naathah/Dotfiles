layout {

    focus-ring {
        active-color   "#a7caed"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a7caed"
        inactive-color "#121316"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a7caed"
        inactive-color "#799cbd"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a7caed80"
    }
}

recent-windows {
    highlight {
        active-color "#a7caed"
        urgent-color "#ffb4ab"
    }
}
