{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "position": "right",
        "padding": { "top": 1, "right": 1, "left": 3},
        "height": 1
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "light_blue"
        },
    },
    "modules": [
       "break",
       "break",
        {
            "type": "title",
            "key": " ",
            "color": {
                "user": "light_blue",
                "at": "white",
                "host": "white"
            }
        },
        "break",
        {
            "type": "chassis",
            "key": " 󰾰",
            "format": "Ideapad Slim 5"

        },
        {
            "type": "os",
            "key": " ",
            "format": "{2}, btw!"
        },
        {
            "type": "kernel",
            "key": " ",
            "format": "{2}"
        },
        {
            "type": "packages",
            "key": " 󰏖",
        },
        {
            "type": "disk",
            "key": " ",
            "folders": ["/"],
            "format": "{size-used}"
        },
        {
            "type": "uptime",
            "key": " 󰅐"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 1,
            "symbol": "circle"
        },
    ]
}
